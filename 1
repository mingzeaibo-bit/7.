def push_pull(img, mask):
    """fill texels where mask is False from the covered ones (pyramid average, smooth extrapolation)."""
    levels = []
    cur, m = img.astype(np.float32), mask.astype(np.float32)
    if cur.ndim == 2:
        cur = cur[..., None]
    while min(cur.shape[:2]) > 1:
        levels.append((cur, m))
        h, w = cur.shape[0] // 2 * 2, cur.shape[1] // 2 * 2
        cw = (cur[:h, :w] * m[:h, :w, None]).reshape(h // 2, 2, w // 2, 2, -1).sum((1, 3))
        mw = m[:h, :w].reshape(h // 2, 2, w // 2, 2).sum((1, 3))
        cur = cw / np.maximum(mw, 1e-8)[..., None]; m = (mw > 0).astype(np.float32)
    for fine, fm in reversed(levels):
        up = np.repeat(np.repeat(cur, 2, 0), 2, 1)[:fine.shape[0], :fine.shape[1]]
        if up.shape[:2] != fine.shape[:2]:
            up = np.pad(up, ((0, fine.shape[0] - up.shape[0]), (0, fine.shape[1] - up.shape[1]), (0, 0)), mode="edge")
        cur = np.where(fm[..., None] > 0, fine, up)
    out = np.clip(cur + 0.5, 0, 255).astype(np.uint8)
    return out[..., 0] if img.ndim == 2 else out


_COV = {}


def coverage(bake, tag, tile):
    """island texels of one baked tile. Blender leaves the background black in colour/roughness/emission/alpha bakes
    and FLAT (128,128,255) in normal bakes, so a texel is covered when any pass differs from that background."""
    key = (bake, tag, tile)
    cd = os.environ.get("TFA_COVER_DIR")                          # exact masks from uv_cover_masks.py win
    if key not in _COV and cd and os.path.isfile(os.path.join(cd, f"{tag}_cover.{tile}.png")):
        _COV[key] = load(os.path.join(cd, f"{tag}_cover.{tile}.png"), "L") > 127
    if key not in _COV:
        cov = None
        for p, mode, test in (("color", "RGB", lambda a: a.sum(2) > 0), ("rough", "L", lambda a: a > 0),
                              ("normal", "RGB", lambda a: np.abs(a.astype(np.int16) - [128, 128, 255]).max(2) > 2),
                              ("emit", "RGB", lambda a: a.sum(2) > 0), ("alpha", "L", lambda a: a > 0)):
            f = os.path.join(bake, f"{tag}_{p}.{tile}.png")
            if os.path.isfile(f):
                c = test(load(f, mode))
                cov = c if cov is None else (cov | c)
        _COV[key] = cov
    return _COV[key]


