NONE_UV = (1.5, 0.5)                                   # outside [0,1]^2 = BodyRegion.None


def cell_uv(name):
    if name is None:
        return NONE_UV
    cu, cv = CELL[name]
    return ((cu + 0.5) / 16.0, (cv + 0.5) / 16.0)


class Body:
    def __init__(self, cfg):
        self.cfg = cfg
        ex = cfg["export_dir"]
        self.man = json.load(open(os.path.join(ex, "manifest.json")))
        self.sk = json.load(open(cfg["skeleton"]))
        sim = json.load(open(cfg["stage2_report"]))["similarity"]
        self.s, self.tu = sim["scale"], C_B2U @ np.array(sim["translation"])
        self.ground = self.sk["ground_offset"]
        mesh = cfg["mesh"]
        z = np.load(os.path.join(ex, mesh + ".npz"))
        fr = np.load(os.path.join(cfg["frames_dir"], mesh + "_frames.npz"))
        self.V = self.nat(z["V"])
        self.T = z["T"].astype(np.int64)
        self.UV = z["LUV_" + cfg["uv_map"]].astype(np.float64)
        self.LN, self.LT, self.LS = fr["LN"].astype(np.float64), fr["LT"].astype(np.float64), fr["LS"].astype(np.float64)
        self.groups = self.man["objects"][mesh]["groups"]
        self.arm = self.man["armature"]
        n = len(self.V)
        W = np.zeros((n, len(self.groups)), np.float32)
        np.add.at(W, (z["VG_I"], z["VG_G"]), z["VG_W"])
        isbone = np.array([g in self.arm for g in self.groups])
        W[:, ~isbone] = 0
        tot = W.sum(1, keepdims=True)
        self.W = W / np.maximum(tot, 1e-12)
        self.unweighted = int((tot[:, 0] <= 1e-9).sum())
        self.Tw = {t["name"]: np.array(t["world"]) for t in self.sk["transforms"]}
        self.vn = self.vertex_normals()
        self.rep = {"source_vertices": n, "source_triangles": len(self.T), "unweighted_vertices": self.unweighted}

    def nat(self, P):
        return (np.asarray(P, float) - self.tu) / self.s - [0, self.ground, 0]

    def bhead(self, b):
        return self.nat(self.arm[b]["head"])

    def btail(self, b):
        return self.nat(self.arm[b]["tail"])

    def vertex_normals(self):
        n = np.zeros_like(self.V)
        np.add.at(n, self.T.reshape(-1), self.LN.reshape(-1, 3))
        return n / np.maximum(np.linalg.norm(n, axis=1, keepdims=True), 1e-12)

    # ------------------------------------------------------------------ bone-group helpers
    def gw(self, prefixes):
        idx = [i for i, g in enumerate(self.groups) if any(g.startswith(p) for p in prefixes)]
        return self.W[:, idx].sum(1) if idx else np.zeros(len(self.V))

    def descendants(self, root):
        kids = collections.defaultdict(list)
        for b, a in self.arm.items():
            if a["parent"]:
                kids[a["parent"]].append(b)
        out, st = set(), [root]
        while st:
            b = st.pop(); out.add(b); st += kids[b]
        return out

    # ------------------------------------------------------------------ skin weights -> game skeleton
    def resolve(self):
        pats = []
        for key, val in self.cfg["skin_map"].items():
            rx = "^" + re.escape(key).replace(r"\{S\}", "(?P<S>[LR])").replace(r"\{J\}", "(?P<J>[123])").replace(r"\*", ".*") + "$"
            pats.append((re.compile(rx), val))
        head_set = self.descendants("DEF-Head") - {"DEF-Head"}

        def fill(v, m):
            if isinstance(v, str):
                for k, x in m.groupdict().items():
                    v = v.replace("{" + k + "}", x)
                return v
            if isinstance(v, dict):
                return {fill(k, m): (fill(x, m) if not isinstance(x, (int, float)) else x) for k, x in v.items()}
            if isinstance(v, list):
                return [fill(x, m) for x in v]
            return v
        memo = {}

        def rule(b):
            if b in memo:
                return memo[b]
            for rx, val in pats:
                m = rx.match(b)
                if m:
                    memo[b] = fill(val, m); return memo[b]
            if b in head_set:
                memo[b] = b; return b                          # face / head bones are skinned directly
            par = self.arm[b]["parent"]
            memo[b] = rule(par) if par else "pelvis_base"
            return memo[b]
        return rule

    def target_weights(self):
        rule = self.resolve()
        cols = {}
        n = len(self.V)

        def col(name):
            if name not in cols:
                assert name in self.Tw, f"skin target {name} missing from skeleton"
                cols[name] = np.zeros(n)
            return cols[name]
        used_rules = {}
        for gi, g in enumerate(self.groups):
            w = self.W[:, gi]
            if g not in self.arm or not w.any():
                continue
            r = rule(g)
            used_rules[g] = r
            if isinstance(r, str):
                col(r)[:] += w
            elif "mix" in r:
                for t, f in r["mix"].items():
                    col(t)[:] += w * f
            elif "split_along" in r:
                h, t = self.bhead(r["split_along"]), self.btail(r["split_along"])
                d = t - h
                u = np.clip(((self.V - h) @ d) / (d @ d), 0, 1)
                a, b = r["at"]
                f1 = np.clip((u - a) / (b - a), 0, 1)
                col(r["bones"][0])[:] += w * (1 - f1)
                col(r["bones"][1])[:] += w * f1
            elif "nearest_of" in r:
                P = np.stack([self.Tw[t][:3, 3] for t in r["nearest_of"]])
                k = np.argmin(np.abs(self.V[:, None, 1] - P[None, :, 1]), axis=1)
                for j, t in enumerate(r["nearest_of"]):
                    col(t)[:] += w * (k == j)
        names = sorted(cols)
        M = np.stack([cols[c] for c in names], 1)
        self.rep["skin_rules"] = {g: r if isinstance(r, str) else json.dumps(r) for g, r in sorted(used_rules.items())}
        return names, M

    @staticmethod
    def top4(M):
        idx = np.argsort(-M, axis=1)[:, :4]
        w = np.take_along_axis(M, idx, 1)
        w = np.where(w > 1e-6, w, 0)
        w /= np.maximum(w.sum(1, keepdims=True), 1e-12)
        q = np.round(w * 65535).astype(np.int64)                       # UNorm16, exact sum 65535
        q[:, 0] += 65535 - q.sum(1)
        return idx, q

